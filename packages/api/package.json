{
  "name": "@panel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./mock": "./mock/index.ts",
    "./schemas": "./schemas.ts",
    "./network": "./network.ts",
    "./template-schema": "./template-schema.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:openapi": "redocly lint openapi.yaml panel-remote.yaml --config redocly.yaml",
    "gen": "openapi-typescript openapi.yaml -o daemon-types.gen.ts && openapi-typescript panel-remote.yaml -o panel-remote-types.gen.ts"
  },
  "dependencies": {
    "@trpc/server": "^11.31.3",
    "superjson": "^2.2.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.83.0",
    "@types/node": "^26.6.11",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2",
    "openapi-typescript": "^7.0.0"
  }
}
