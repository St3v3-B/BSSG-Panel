# /etc/panel/panel.env — één bestand voor panel (docker-compose) en daemon (systemd EnvironmentFile=).
# Het installscript vraagt de waarden en schrijft dit bestand (chmod 600, root).
# Namen van variabelen zijn een contract: wijzigen alleen via de orchestrator.
# Niets in de code hardcodet een domein; tests gebruiken panel.test en node1.test.

# --- verplicht ---
PANEL_DOMAIN=panel.example.nl
NODE_DOMAIN=node1.example.nl
ACME_EMAIL=admin@example.nl
# Discord-ID van de eigenaar; bij de eerste start in admin_discord_ids gezet, kan nooit weg.
OWNER_DISCORD_ID=
# Discord OAuth2-app; redirect-URI: https://$PANEL_DOMAIN/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: Discord bot with slash commands (/servers /status /start /stop /restart).
# Empty = bot off. Create a bot in the Discord Developer Portal (no intents needed),
# invite it with scope applications.commands and paste the bot token here.
DISCORD_BOT_TOKEN=
# 32 bytes base64 (openssl rand -base64 32); AES-256-GCM voor geheimen in de database.
PANEL_ENCRYPTION_KEY=
# Token van de lokale node (openssl rand -hex 32). Het panel zet de hash bij elke start
# op de lokale node (is_local) en de daemon gebruikt hem als Bearer-token.
NODE_TOKEN=

# --- optioneel (standaardwaarden) ---
# IPv4 voor de DNS-instructies; leeg = automatisch detecteren.
NODE_PUBLIC_IP=
# Standaard de containers uit docker-compose.
DATABASE_URL=postgres://panel:panel@postgres:5432/panel
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=panel
# Root-wachtwoord van de lokale MariaDB (panel-mariadb); install.sh genereert hem.
MARIADB_ROOT_PASSWORD=
# Containernaam van de lokale MariaDB: de daemon koppelt hem aan site-netwerken en sites
# bereiken hem op deze naam. Tests gebruiken een eigen naam.
MARIADB_CONTAINER=panel-mariadb
# Hoe het panel zelf MariaDB bereikt voor beheer (host:poort). Standaard $MARIADB_CONTAINER:3306.
MARIADB_ADMIN_ADDR=
# phpMyAdmin (sidebar item, single sign-on). install.sh/upgrade.sh generate both (openssl rand -hex 32).
# PMA_SHARED_SECRET: bearer between the phpMyAdmin container and the panel (/api/pma/exchange); empty = feature off.
# PMA_BLOWFISH_SECRET: cookie encryption key of phpMyAdmin (>= 32 characters).
PMA_SHARED_SECRET=
PMA_BLOWFISH_SECRET=
# Optional: databases on remote nodes in phpMyAdmin. The panel listens per remote node on
# PMA_TUNNEL_BIND:(PMA_TUNNEL_PORT_BASE + node id) inside its container (not published) and forwards each connection
# through that node's daemon (GET /api/db/tunnel over the daemon HTTPS) to the node's MariaDB. Only loopback and
# PMA_TUNNEL_ALLOW (hostnames/IPs, default: the phpmyadmin container) may connect. Defaults: 40000, 0.0.0.0, phpmyadmin.
# PMA_TUNNEL_PORT_BASE=40000
# PMA_TUNNEL_BIND=0.0.0.0
# PMA_TUNNEL_ALLOW=phpmyadmin
SFTP_PORT=2022
DAEMON_PORT=8080
# Hoe vaak de daemon op nieuwe images controleert (Go-duur, bv. 24h; 0 = uit). Beleid en
# onderhoudsvenster stel je in het panel in (admin > Settings).
IMAGE_CHECK_INTERVAL=24h

# --- mailmodule (optioneel, alleen op de panel-machine; zie docs/mail.md) ---
# Hostnaam van de mailserver (bv. mail.voorbeeld.nl): HELO/banner van Postfix, MX-doel, PTR moet hierheen wijzen.
# Caddy haalt er een certificaat voor zodra dit gezet is (Postfix/Dovecot lezen het uit caddy_data).
# Leeg = mailmodule uit (aanzetten kan dan niet).
MAIL_HOSTNAME=
# Wachtwoord van de read-only databaserol mail_reader (Postfix/Dovecot lezen domeinen en mailboxen uit
# de panel-database). install.sh genereert het; het panel zet de rol bij elke start.
MAIL_DB_PASSWORD=
# Publieke IPv4/IPv6 van de mailserver voor de systeemcheck (PTR, FCrDNS, blacklists) en de DNS-records.
# Leeg = automatisch detecteren.
MAIL_PUBLIC_IPV4=
MAIL_PUBLIC_IPV6=
# Compose-profielen die install.sh/upgrade.sh (en de daemon) meestarten, komma-gescheiden. "mail" = de
# mailstack staat aan; deploy/mail.sh enable|disable houdt dit bij. Niet met de hand op "mail" zetten
# zonder MAIL_HOSTNAME (install.sh laat het profiel dan weg).
COMPOSE_PROFILES=

# --- intern / voor tests (meestal niet aanpassen) ---
# Hoe de daemon het panel bereikt. Standaard https://$PANEL_DOMAIN.
PANEL_URL=
# Hoe het panel de lokale daemon bereikt. Standaard https://$NODE_DOMAIN.
DAEMON_URL=
# Unix-socket waarop de daemon luistert voor Caddy.
DAEMON_SOCKET=/run/panel/daemon.sock
# Data van servers; volumes in $DATA_DIR/volumes/<uuid>, daemon-state in $DATA_DIR/state.
DATA_DIR=/var/lib/panel
# Caddy admin-API. In productie een unix-socket in de gedeelde map (niet via TCP, zodat
# site-containers op hetzelfde netwerk er niet bij kunnen). Leeg = fake router (tests).
CADDY_ADMIN_URL=unix:///run/panel/caddy-admin.sock
# Waar Caddy HTTPS serveert, voor de SSL-controle van de daemon.
CADDY_TLS_ADDR=127.0.0.1:443
# Naam van de Caddy-container die aan site-netwerken gekoppeld wordt.
CADDY_CONTAINER=panel-caddy
# HTTP(S)-relay (Admin > Nodes > HTTP(S)-ingang). direct = Caddy op de eigen 80/443 (standaard). relay = alleen remote
# nodes: Caddy zonder publieke poorten, al het HTTP(S) loopt via een andere node (uitgaande tunnel); compose-profiel
# caddy-relay. npm = achter Nginx Proxy Manager (Admin > Nodes > Nginx Proxy Manager): NPM houdt 80/443 en SSL, Caddy
# draait HTTP-only op NPM_CADDY_ADDR (compose-profiel caddy-npm; op de panel-machine docker-compose.npm.yml).
# Omzetten: join.sh --http-mode relay|direct|npm (remote node) of install.sh --http-mode direct|npm (panel-machine).
HTTP_MODE=direct
# Alleen bij HTTP_MODE=npm: waar Caddy HTTP-only luistert en NPM hem bereikt (host:poort, standaard het docker0-adres).
# Het panel kan per node een ander forward-adres zetten; de daemon gebruikt dit als dat leeg is.
NPM_CADDY_ADDR=172.17.0.1:8081
# Alleen panel-machine met HTTP_MODE=npm (install.sh --npm-url/--npm-email/--npm-password): eerste NPM-login, zodat het
# panel zijn eigen proxy hosts kan maken voordat iemand kan inloggen. Bij de start één keer overgenomen naar Admin > Nodes
# (versleuteld in de database); daarna gelden de instellingen daar en mag dit leeg. NPM-account met de rol admin, zonder 2FA.
NPM_URL=
NPM_EMAIL=
NPM_PASSWORD=
# Unix-socket waarop deze node HTTP(S) van nodes die via hem lopen aanneemt (Caddy proxyt erheen); "off" = nooit relay.
RELAY_SOCKET=/run/panel/relay.sock
# Map met templates/game en templates/web die het panel bij de start inlaadt.
TEMPLATES_DIR=/app/templates
# De daemon raakt alleen Docker-objecten met panel.managed=true én panel.instance=$PANEL_INSTANCE.
PANEL_INSTANCE=main
# Niet in dit bestand, alleen voor docker compose / tests: PANEL_ENV_FILE wijst het
# env_file van de panel-container naar een ander bestand (standaard /etc/panel/panel.env).
# Background node monitor (milliseconds): poll interval, max backoff for unreachable nodes,
# when a node counts as stale (status "unknown"), and the per-request timeout.
NODE_POLL_INTERVAL_MS=5000
NODE_POLL_MAX_BACKOFF_MS=60000
NODE_STALE_AFTER_MS=30000
NODE_POLL_TIMEOUT_MS=2500
# De checkout waar install.sh draaide (install.sh schrijft dit zelf). deploy/upgrade.sh en de
# knop Update panel (Admin > Settings > Updates) gebruiken hem; leeg op remote nodes = geen updates.
PANEL_REPO_DIR=
# GitHub-repo (owner/naam) voor de CI-status op de Updates-pagina; leeg = afleiden uit de git-remote van de checkout.
PANEL_GITHUB_REPO=
# IPv4-blok waaruit de daemon elk servernetwerk een eigen subnet geeft (/28 per server,
# /26 per Velocity-netwerk). Leeg = 10.213.0.0/16; "docker" = Docker kiest uit zijn
# standaardpools (daar passen maar ~30 netwerken in). Mag niet overlappen met je LAN/VPN.
DOCKER_NETWORK_POOL=
# Image voor de webterminal en SSH-shell (tools-container met de bestanden van de server).
# Leeg = de image van de server zelf (bij PHP-sites: php + composer in de PHP-versie van de site).
TERMINAL_IMAGE=
# Image waarmee Git-deploy de repository ophaalt. Leeg = alpine/git (vaste versie in de daemon).
DEPLOY_GIT_IMAGE=
# Alleen tests: extra labels op alles wat de daemon aanmaakt (bv. panel.test=true).
DOCKER_EXTRA_LABELS=
# Alleen tests: maakt POST /api/auth/test/login beschikbaar. Werkt uitsluitend als
# PANEL_DOMAIN op .test eindigt; anders weigert het panel te starten.
PANEL_INSECURE_TEST_LOGIN=0
# Sessies: verlopen na zoveel dagen zonder gebruik, en altijd na de absolute levensduur.
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
