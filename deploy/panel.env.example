# /etc/panel/panel.env — één bestand voor panel (docker-compose) en daemon (systemd EnvironmentFile=).
# Het installscript vraagt de waarden en schrijft dit bestand (chmod 600, root).
# Namen van variabelen zijn een contract: wijzigen alleen via de orchestrator.
# Niets in de code hardcodet een domein; tests gebruiken panel.test en node1.test.

# --- verplicht ---
PANEL_DOMAIN=panel.example.nl
NODE_DOMAIN=node1.example.nl
ACME_EMAIL=admin@example.nl
# Discord-ID van de eigenaar; bij de eerste start in admin_discord_ids gezet, kan nooit weg.
OWNER_DISCORD_ID=
# Discord OAuth2-app; redirect-URI: https://$PANEL_DOMAIN/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 32 bytes base64 (openssl rand -base64 32); AES-256-GCM voor geheimen in de database.
PANEL_ENCRYPTION_KEY=
# Token van de lokale node (openssl rand -hex 32). Het panel zet de hash bij elke start
# op de lokale node (is_local) en de daemon gebruikt hem als Bearer-token.
NODE_TOKEN=

# --- optioneel (standaardwaarden) ---
# IPv4 voor de DNS-instructies; leeg = automatisch detecteren.
NODE_PUBLIC_IP=
# Standaard de containers uit docker-compose.
DATABASE_URL=postgres://panel:panel@postgres:5432/panel
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=panel
SFTP_PORT=2022
DAEMON_PORT=8080

# --- intern / voor tests (meestal niet aanpassen) ---
# Hoe de daemon het panel bereikt. Standaard https://$PANEL_DOMAIN.
PANEL_URL=
# Hoe het panel de lokale daemon bereikt. Standaard https://$NODE_DOMAIN.
DAEMON_URL=
# Unix-socket waarop de daemon luistert voor Caddy.
DAEMON_SOCKET=/run/panel/daemon.sock
# Data van servers; volumes in $DATA_DIR/volumes/<uuid>, daemon-state in $DATA_DIR/state.
DATA_DIR=/var/lib/panel
# Caddy admin-API (alleen localhost). Leeg = daemon gebruikt een fake router (tests).
CADDY_ADMIN_URL=http://127.0.0.1:2019
# Naam van de Caddy-container die aan site-netwerken gekoppeld wordt.
CADDY_CONTAINER=panel-caddy
# Map met templates/game en templates/web die het panel bij de start inlaadt.
TEMPLATES_DIR=/app/templates
# De daemon raakt alleen Docker-objecten met panel.managed=true én panel.instance=$PANEL_INSTANCE.
PANEL_INSTANCE=main
# Alleen tests: extra labels op alles wat de daemon aanmaakt (bv. panel.test=true).
DOCKER_EXTRA_LABELS=
# Alleen tests: maakt POST /api/auth/test/login beschikbaar. Werkt uitsluitend als
# PANEL_DOMAIN op .test eindigt; anders weigert het panel te starten.
PANEL_INSECURE_TEST_LOGIN=0
