# Caddy-basisconfig van het panel (eigenaar: web-hosting).
#
# Niet per installatie aanpassen: alle installatiekeuzes komen uit de omgeving
# (/etc/panel/panel.env via docker-compose). Zie README.md.
#
# Vaste routes (dit bestand): $PANEL_DOMAIN -> panel, $NODE_DOMAIN -> daemon.
# Dynamische routes (klantdomeinen) zet de daemon via de admin-API in de server
# met de naam "panel" (zie `servers :443 { name panel }` hieronder), als routes met
# "@id": "panel-dyn-<host>". Ze komen achter de vaste routes en worden bij elke
# Caddy-herstart door de daemon opnieuw gezet (Sync). Zet hier dus geen catch-all
# site (zoals `:443` of `https://`): die zou de dynamische routes overschaduwen.
#
# HTTP -> HTTPS doet Caddy zelf (automatic HTTPS), ook voor de dynamische routes.
{
	email {$ACME_EMAIL}

	# Alleen op een unix-socket in de gedeelde map met de daemon, nooit op TCP:
	# Caddy hangt aan site-netwerken, en sites mogen de admin-API niet bereiken.
	# De daemon gebruikt CADDY_ADMIN_URL=unix:///run/panel/caddy-admin.sock.
	admin unix//run/panel/caddy-admin.sock

	# Vaste naam voor de HTTPS-server: hier landen de dynamische routes.
	# Contract met daemon/proxy/caddy.go.
	servers :443 {
		name panel
	}

	# Extra globale opties voor tests en staging (bv. `local_certs` of
	# `acme_ca ...`). In productie is deze map leeg. Zie examples/.
	import /etc/caddy/global.d/*.caddy
}

{$PANEL_DOMAIN} {
	# phpMyAdmin (container panel-phpmyadmin op het netwerk panel-pma); het panel regelt de single sign-on.
	# PMA_ABSOLUTE_URI=https://$PANEL_DOMAIN/phpmyadmin/ zorgt dat phpMyAdmin zijn eigen links goed maakt.
	redir /phpmyadmin /phpmyadmin/ 308
	handle_path /phpmyadmin/* {
		reverse_proxy phpmyadmin:80
	}

	handle {
		reverse_proxy panel:3000
	}
}

{$NODE_DOMAIN} {
	# Daemon op de unix-socket (/run/panel wordt in de container gemount).
	# Websockets werken vanzelf; flush_interval -1 voor de log-streams.
	reverse_proxy unix//run/panel/daemon.sock {
		flush_interval -1
		# Websockets (console, relay-tunnels van andere nodes) niet direct sluiten bij elke
		# config-wijziging via de admin-API (nieuwe route), maar pas na een uur.
		stream_close_delay 1h
	}
}

# Mailmodule: alleen als MAIL_HOSTNAME gezet is (compose zet dan MAIL_CADDY=on) een site voor het certificaat
# van Postfix/Dovecot. Zonder MAIL_HOSTNAME matcht "-site*.caddy" niets. Zie mail/on-site.caddy en docs/mail.md.
import /etc/caddy/mail/{$MAIL_CADDY}-site*.caddy
