# Postfix main.cf of the mail module (panel-postfix). Copied by the entrypoint to /etc/postfix; it sets
# myhostname (= MAIL_HOSTNAME) and smtpd_tls_chain_files (certificate from Caddy) with postconf.
# Domains, mailboxes and aliases come from the panel database (views mail.v_*, read-only role mail_reader).
compatibility_level = 3.6
myhostname = localhost
myorigin = $myhostname
# No local delivery: all mail domains are virtual (mail.v_domains).
mydestination =
local_transport = error:local delivery is disabled
alias_maps =
alias_database =
# Only loopback is trusted; everything else must authenticate (SASL) to relay.
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = all
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
recipient_delimiter = +
message_size_limit = 52428800
mailbox_size_limit = 0
maillog_file = /dev/stdout
smtputf8_enable = no

# --- virtual domains (lookups via proxymap: one connection pool for all smtpd processes)
virtual_mailbox_domains = proxy:pgsql:/etc/postfix/pgsql/domains.cf
virtual_mailbox_maps = proxy:pgsql:/etc/postfix/pgsql/mailboxes.cf
# Aliases first, then every mailbox to itself: so a catch-all alias (@domain) does not swallow mail for
# existing mailboxes (Postfix tries user@domain in all tables before @domain).
virtual_alias_maps = proxy:pgsql:/etc/postfix/pgsql/aliases.cf, proxy:pgsql:/etc/postfix/pgsql/mailbox_self.cf
# Delivery to Dovecot over LMTP (container dovecot on the panel-mail network).
virtual_transport = lmtp:inet:dovecot:24
lmtp_host_lookup = native
smtp_host_lookup = dns, native

# --- SASL (only on submission/submissions, see master.cf) via the Dovecot auth service
smtpd_sasl_type = dovecot
smtpd_sasl_path = inet:dovecot:12345
smtpd_sasl_auth_enable = no
smtpd_sasl_security_options = noanonymous
smtpd_sasl_tls_security_options = noanonymous
broken_sasl_auth_clients = no
# Send only as your own address or as an alias that delivers to you (mail.v_senders).
smtpd_sender_login_maps = proxy:pgsql:/etc/postfix/pgsql/senders.cf

# --- restrictions: no open relay
smtpd_helo_required = yes
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
smtpd_relay_restrictions = permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, reject_unlisted_recipient
smtpd_sender_restrictions = reject_non_fqdn_sender, reject_authenticated_sender_login_mismatch
smtpd_helo_restrictions = reject_invalid_helo_hostname
smtpd_data_restrictions = reject_unauth_pipelining

# --- TLS: only 1.2+, no auth without TLS
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = high
smtpd_tls_ciphers = high
smtpd_tls_exclude_ciphers = aNULL, eNULL, MD5, RC4, 3DES
smtpd_tls_received_header = yes
smtpd_tls_loglevel = 1
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
# smtpd_tls_chain_files: set by the entrypoint / mail-reload.
smtp_tls_security_level = may
smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
tls_preempt_cipherlist = yes

# --- Rspamd (spam, ClamAV, DKIM signing) as milter; when Rspamd is down mail keeps flowing unfiltered.
smtpd_milters = inet:rspamd:11332
non_smtpd_milters = $smtpd_milters
milter_protocol = 6
milter_default_action = accept
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
