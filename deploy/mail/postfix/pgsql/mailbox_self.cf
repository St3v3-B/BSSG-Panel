# virtual_alias_maps: every mailbox to itself (so a catch-all does not take over existing mailboxes).
# __PLACEHOLDERS__ are filled in by the entrypoint (password from MAIL_DB_PASSWORD).
hosts = __MAIL_DB_HOST__
dbname = __MAIL_DB_NAME__
user = mail_reader
password = __MAIL_DB_PASSWORD__
query = SELECT address FROM mail.v_mailboxes WHERE address = '%s'
