{
  "name": "@panel/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node copy-monaco.mjs && PANEL_MOCK=1 NEXT_PUBLIC_PANEL_MOCK=1 next dev -p 3000",
    "dev:real": "node copy-monaco.mjs && next dev -p 3000",
    "build": "node copy-monaco.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "emergency": "tsx server/cli/emergency.ts",
    "build:cli": "esbuild server/cli/emergency.ts --bundle --platform=node --format=esm --target=node22 --outfile=emergency-cli.mjs --external:@node-rs/* --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@node-rs/argon2": "^2.2.2",
    "@panel/api": "workspace:*",
    "@panel/db": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-query": "^5.108.4",
    "@trpc/client": "^11.31.3",
    "@trpc/react-query": "^11.31.3",
    "@trpc/server": "^11.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.7",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.1.0",
    "lucide-react": "^1.81.0",
    "mariadb": "^3.5.5",
    "minio": "^8.0.7",
    "monaco-editor": "0.58.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "ssh2": "^1.17.0",
    "superjson": "^2.2.7",
    "tailwind-merge": "^3.7.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "esbuild": "0.25.12",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2"
  }
}
